  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Heimdall's action: submit, allow, try again. Fills the column in a form.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">Sign in</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;min-height:var(--hd-control,48px);padding:8px 24px;border:2px solid var(--hd-lapis,#1e2f7a);border-radius:0;background:var(--hd-lapis,#1e2f7a);color:var(--hd-on-lapis,#fff);font:inherit;font-size:1.125rem;font-weight:700;cursor:pointer;transition:background-color 120ms cubic-bezier(0.16,1,0.3,1)}.ds-btn-primary:hover{background:var(--hd-lapis-strong,#14205a);border-color:var(--hd-lapis-strong,#14205a)}.ds-btn-primary:focus-visible{outline:3px solid var(--hd-focus,#ffd21f);outline-offset:0;box-shadow:0 0 0 3px var(--hd-focus,#ffd21f),0 6px 0 0 var(--hd-focus-ink,#0b0c14)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "The second choice, such as Deny, and the Show toggle in the password row.",
      "html": "<button class=\"ds-btn-secondary\" type=\"button\">Deny</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:8px 24px;border:2px solid var(--hd-ink,#0b0c14);border-radius:0;background:var(--hd-page,#fff);color:var(--hd-ink,#0b0c14);font:inherit;font-size:1.125rem;font-weight:700;cursor:pointer;transition:background-color 120ms cubic-bezier(0.16,1,0.3,1)}.ds-btn-secondary:hover{background:var(--hd-ground,#eef1f8)}.ds-btn-secondary:focus-visible{outline:3px solid var(--hd-focus,#ffd21f);outline-offset:0;box-shadow:0 0 0 3px var(--hd-focus,#ffd21f),0 6px 0 0 var(--hd-focus-ink,#0b0c14)}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Bold label above a square 48px input. The invalid state uses a 4px red border and a red message.",
      "html": "<div class=\"ds-field\"><label class=\"ds-label\" for=\"ds-email\">Email address</label><input class=\"ds-input\" id=\"ds-email\" type=\"email\"></div><div class=\"ds-field\"><label class=\"ds-label\" for=\"ds-pw\">Password</label><p class=\"ds-field-error\">Enter your password.</p><input class=\"ds-input\" id=\"ds-pw\" type=\"password\" aria-invalid=\"true\"></div>",
      "css": ".ds-field{display:grid;gap:8px;margin-bottom:24px;max-width:30rem}.ds-label{font-weight:700;font-size:1.125rem}.ds-field-error{margin:0;color:var(--hd-red,#b3261e);font-weight:700;font-size:1rem}.ds-input{width:100%;min-height:48px;padding:8px 12px;border:2px solid var(--hd-ink,#0b0c14);border-radius:0;background:var(--hd-page,#fff);color:var(--hd-ink,#0b0c14);font:inherit;font-size:1.125rem}.ds-input[aria-invalid='true']{border-color:var(--hd-red,#b3261e);border-width:4px;padding:6px 10px}.ds-input:focus{outline:none}.ds-input:focus-visible{outline:3px solid var(--hd-focus,#ffd21f);outline-offset:0;box-shadow:0 0 0 3px var(--hd-focus,#ffd21f),0 6px 0 0 var(--hd-focus-ink,#0b0c14)}"
    },
    {
      "name": "Band and Origin Plate",
      "kind": "custom",
      "refersTo": "origin-plate",
      "description": "The signature frame: the lapis band with the wordmark, and the plate that hangs from it with the current host in monospace.",
      "html": "<header class=\"ds-band\"><p class=\"ds-wordmark\">Heimdall</p></header><p class=\"ds-plate\"><span class=\"ds-plate-label\">Signing in to</span><span class=\"ds-plate-host\">acme.localhost:7200</span></p>",
      "css": ".ds-band{display:flex;align-items:center;min-height:64px;padding:0 16px;background:var(--hd-lapis,#1e2f7a);color:var(--hd-on-lapis,#fff)}.ds-wordmark{margin:0;font-size:1.5rem;font-weight:800;letter-spacing:-0.01em;line-height:1}.ds-plate{display:inline-flex;flex-direction:column;gap:4px;margin:0 0 0 16px;padding:12px 16px 16px;background:var(--hd-lapis,#1e2f7a);color:var(--hd-on-lapis,#fff);clip-path:polygon(0 0,100% 0,100% 100%,50% calc(100% - 0.5rem),0 100%)}.ds-plate-label{color:var(--hd-on-lapis-muted,#c9d1f0);font-size:0.875rem;font-weight:600}.ds-plate-host{font-family:ui-monospace,'SF Mono','Cascadia Mono','DejaVu Sans Mono',Menlo,Consolas,monospace;font-size:1.125rem;font-weight:700;overflow-wrap:anywhere}"
    },
    {
      "name": "Client Band and Plate",
      "kind": "custom",
      "refersTo": "band-client",
      "description": "The same frame in Client Slate for a site that is not Heimdall, with band navigation.",
      "html": "<header class=\"ds-cband\"><p class=\"ds-cword\">Demo client</p><nav class=\"ds-cnav\"><a href=\"#\" class=\"ds-active\" aria-current=\"page\">Tokens</a><a href=\"#\">User info</a></nav></header><p class=\"ds-cplate\"><span class=\"ds-cplate-label\">A Heimdall client app on</span><span class=\"ds-cplate-host\">demo.localhost:4300</span></p>",
      "css": ".ds-cband{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:64px;padding:0 16px;background:var(--hd-client,#2b2e36);color:#fff}.ds-cword{margin:0;font-size:1.5rem;font-weight:800;letter-spacing:-0.01em;line-height:1}.ds-cnav{display:flex;gap:16px}.ds-cnav a{color:#fff;text-decoration:none;font-weight:600;padding:4px 0;border-bottom:3px solid transparent}.ds-cnav a:hover{border-bottom-color:var(--hd-on-lapis-muted,#c9d1f0)}.ds-cnav a.ds-active{border-bottom-color:#fff}.ds-cnav a:focus-visible{outline:none;background:var(--hd-focus,#ffd21f);color:var(--hd-focus-ink,#0b0c14);box-shadow:0 -2px var(--hd-focus,#ffd21f),0 4px var(--hd-focus-ink,#0b0c14)}.ds-cplate{display:inline-flex;flex-direction:column;gap:4px;margin:0 0 0 16px;padding:12px 16px 16px;background:var(--hd-client,#2b2e36);color:#fff;clip-path:polygon(0 0,100% 0,100% 100%,50% calc(100% - 0.5rem),0 100%)}.ds-cplate-label{color:var(--hd-on-lapis-muted,#c9d1f0);font-size:0.875rem;font-weight:600}.ds-cplate-host{font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace;font-size:1.125rem;font-weight:700}"
    },
    {
      "name": "Problem Box",
      "kind": "card",
      "refersTo": "problem-box",
      "description": "A refusal or failure. Full 2px red border, red tint, bold red title. It takes focus when it appears.",
      "html": "<div class=\"ds-problem\" role=\"alert\"><p class=\"ds-problem-title\">There is a problem</p><p>The email or the password is not correct.</p></div>",
      "css": ".ds-problem{max-width:30rem;padding:16px 24px;border:2px solid var(--hd-red,#b3261e);background:var(--hd-red-tint,#fbeae8);color:var(--hd-ink,#0b0c14);font-size:1.125rem;line-height:1.55}.ds-problem p{margin:0}.ds-problem-title{color:var(--hd-red,#b3261e);font-weight:700}"
    },
    {
      "name": "Confirm Box",
      "kind": "card",
      "refersTo": "confirm-box",
      "description": "A done or confirmed result. Full 2px green border, green tint, bold green title.",
      "html": "<div class=\"ds-confirm\"><p class=\"ds-confirm-title\">Reuse detected. The family is revoked.</p><p>The client dropped its tokens and must sign in again.</p></div>",
      "css": ".ds-confirm{max-width:30rem;padding:16px 24px;border:2px solid var(--hd-green,#0b6b3a);background:var(--hd-green-tint,#e5f3ea);color:var(--hd-ink,#0b0c14);font-size:1.125rem;line-height:1.55}.ds-confirm p{margin:0}.ds-confirm-title{color:var(--hd-green,#0b6b3a);font-weight:700}"
    },
    {
      "name": "Status Mark",
      "kind": "chip",
      "refersTo": "status-mark",
      "description": "Demo only. An inline result mark in the state color: red Refused, green Issued.",
      "html": "<span class=\"ds-mark ds-mark-refused\">Refused</span> <span class=\"ds-mark ds-mark-issued\">Issued</span>",
      "css": ".ds-mark{display:inline-block;padding:0 8px;border:2px solid currentColor;font-size:0.875rem;font-weight:700}.ds-mark-refused{color:var(--hd-red,#b3261e)}.ds-mark-issued{color:var(--hd-green,#0b6b3a)}"
    },
    {
      "name": "Ruled Table",
      "kind": "custom",
      "refersTo": "table",
      "description": "Full-width data table: bold caption, 2px ink header rule, hairlines between rows, mono values.",
      "html": "<table class=\"ds-table\"><caption>ID token claims</caption><thead><tr><th scope=\"col\">Claim</th><th scope=\"col\">Value</th></tr></thead><tbody><tr><th scope=\"row\">iss</th><td><code>https://acme.localhost:7200</code></td></tr><tr><th scope=\"row\">aud</th><td><code>demo-spa</code></td></tr></tbody></table>",
      "css": ".ds-table{width:100%;max-width:48rem;border-collapse:collapse;font-size:1rem}.ds-table caption{text-align:start;font-weight:700;padding-bottom:4px}.ds-table th,.ds-table td{text-align:start;vertical-align:top;padding:12px 16px 12px 0;border-bottom:1px solid var(--hd-rule,#c7cddf)}.ds-table thead th{border-bottom:2px solid var(--hd-ink,#0b0c14)}.ds-table code{font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace}"
    }
  ],
  "narrative": {
    "northStar": "The Public-Service Notice",
    "overview": "Each page reads as a notice from the issuer. It states who asks, which origin the browser is on, what leaves, and nothing else. The world is a public-service identity program, like a government design system. A committed lapis band runs across the top. A white page carries one left-aligned column. A cool, lapis-tinted ground closes the page below the column.\n\nHierarchy comes from scale and weight only. Body text is large (1.125rem). Headings step up in bold. No card, panel, or shadow ranks content. Boxes appear only to carry a state: a refusal, a confirmation, or a neutral note. Controls are square, with a 2px ink border and a height of 48px.\n\nEvery page uses one frame: the band, the origin plate, the column, and the footer. The login, consent, error, and signed-out pages keep the same frame, column, and heading baseline. So they read as one sequence. The demo client uses the same frame with a neutral band, so the user can see that it is a different site. Every page states that Heimdall is a development build.",
    "keyCharacteristics": [
      "A lapis issuer band (64px) with the wordmark \"Heimdall\" at the left.",
      "An origin plate hangs from the band and shows the current host in monospace.",
      "A white page with a left-aligned column (30rem), and a tinted ground for the footer.",
      "Square controls: 2px border, 48px tall, no radius anywhere.",
      "A fixed state vocabulary: lapis speaks and acts, red refuses, green confirms, yellow marks focus.",
      "The system font stack only. No web font and no third-party origin (U8).",
      "Light and dark themes from `prefers-color-scheme`."
    ],
    "rules": [
      {
        "name": "The One Meaning Rule",
        "body": "Each state color means one thing on every page. Lapis speaks or acts. Red refuses or fails. Green confirms. Yellow marks keyboard focus and nothing else.",
        "section": "colors"
      },
      {
        "name": "The Tokens Not Components Rule",
        "body": "Tenant branding (Phase 3) changes token values. It never changes a component.",
        "section": "colors"
      },
      {
        "name": "The Scale Contrast Rule",
        "body": "Size and weight rank content. A heading never gets a box, a color, or a rule to look important.",
        "section": "typography"
      },
      {
        "name": "The Machine Value Rule",
        "body": "Monospace marks only values that a user or a machine compares character by character. Prose never uses mono.",
        "section": "typography"
      },
      {
        "name": "The One Frame Rule",
        "body": "Every page uses the same band, plate, column, and footer. A new page changes the content of the column, never the frame.",
        "section": "layout"
      },
      {
        "name": "The Flat Notice Rule",
        "body": "Surfaces stay flat in every state. A shadow appears only as part of keyboard focus.",
        "section": "elevation"
      },
      {
        "name": "The Square Corner Rule",
        "body": "No element has a border radius. The plate notch is the only shaped edge.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do put every new page inside the one frame: band, origin plate, column, footer.",
      "Do rank content with size and weight: Display for the page title, Headline for sections, Body at 1.125rem.",
      "Do keep controls square, with a 2px border and a height of 48px.",
      "Do use lapis for Heimdall and its actions, red for a refusal, green for a confirmation, and yellow for focus only.",
      "Do show machine values (hosts, IDs, scopes, error codes) in monospace.",
      "Do use the client band and plate color for any site that is not Heimdall.",
      "Do keep text at 4.5:1 contrast or more in both themes.",
      "Do state on every page that Heimdall is a development build, until the owner decides otherwise."
    ],
    "donts": [
      "Don't add a web font or load anything from a third-party origin (U8).",
      "Don't use a card, a panel, or a shadow to rank content. A box carries a state only.",
      "Don't use yellow for anything except keyboard focus.",
      "Don't give a state color a second meaning, for example green for a brand accent.",
      "Don't round a corner. The plate notch is the only shaped edge.",
      "Don't mark a message with a thick side stripe. A message box has a full border.",
      "Don't add a small label above a page title. The title stands alone.",
      "Don't change a component for tenant branding. Change tokens only."
    ]
  }
}