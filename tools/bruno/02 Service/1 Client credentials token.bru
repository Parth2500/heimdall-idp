meta {
  name: Client credentials token
  type: http
  seq: 1
}

post {
  url: {{issuer}}/oauth/v1/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: {{serviceClientId}}
  password: {{serviceClientSecret}}
}

body:form-urlencoded {
  grant_type: client_credentials
  scope: demo.read
  resource: {{audience}}
}

docs {
  A service gets a token with no user (client_credentials). The client authenticates with client_secret_basic (D10).
}

script:post-response {
  bru.setVar("serviceAccessToken", res.getBody().access_token);
}

tests {
  test("issues a bearer token for the audience", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().token_type).to.equal("Bearer");
    expect(res.getBody()).to.not.have.property("refresh_token");
    expect(res.getHeader("cache-control")).to.contain("no-store");
  });
}
