meta {
  name: Introspect own token
  type: http
  seq: 2
}

post {
  url: {{issuer}}/oauth/v1/introspect
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: {{serviceClientId}}
  password: {{serviceClientSecret}}
}

body:form-urlencoded {
  token: {{serviceAccessToken}}
}

docs {
  RFC 7662. A confidential client may introspect its own tokens and the tokens for its resource audiences (D37).
}

tests {
  test("the token is active", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().active).to.equal(true);
    expect(res.getBody().client_id).to.equal(bru.getEnvVar("serviceClientId"));
  });
}
