meta {
  name: Wrong secret
  type: http
  seq: 3
}

post {
  url: {{issuer}}/oauth/v1/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: {{serviceClientId}}
  password: not-the-secret
}

body:form-urlencoded {
  grant_type: client_credentials
}

docs {
  An unknown client and a wrong secret get the same answer (D5). Each failure counts against the IP's failure limit.
}

tests {
  test("is invalid_client", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error).to.equal("invalid_client");
  });
}
